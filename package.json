{
  "name": "copilot-proxy",
  "version": "1.0.0",
  "description": "Standalone proxy for GitHub Copilot API — bridges Claude Code with Copilot",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "autostart": "powershell.exe -NoProfile -File scripts\\autostart.ps1",
    "sync:codex": "tsx scripts/sync-codex-catalog.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
